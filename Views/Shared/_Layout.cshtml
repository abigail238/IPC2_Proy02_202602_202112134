<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Catálogo de Libros</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="barra-superior"><a asp-controller="Home" asp-action="Index">Catálogo de Libros</a></header>
    <nav class="menu-lateral" aria-label="Menú principal">
        <h2>Sistema</h2>
        <a asp-controller="Home" asp-action="Index" asp-fragment="inicializar">Inicializar el Sistema</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="cargar">Cargar Archivo XML de Entrada</a>
        <h2>Catálogo</h2>
        <a asp-controller="Home" asp-action="Index" asp-fragment="estructura">Mostrar Estructura de Categorías</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="graphviz">Mostrar Libros de una Categoría (Graphviz)</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="agregar-categoria">Agregar una Categoría</a>
        <h2>Libros</h2>
        <a asp-controller="Home" asp-action="RegistrarLibro">Registrar un nuevo libro</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="eliminar">Eliminar un Libro</a>
        <a asp-controller="Home" asp-action="Index" asp-route-extremo="menor" asp-fragment="resultado">Libro con ISBN Menor</a>
        <a asp-controller="Home" asp-action="Index" asp-route-extremo="mayor" asp-fragment="resultado">Libro con ISBN Mayor</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="buscar">Buscar Libro por ISBN</a>
        <h2>Ayuda</h2>
        <a asp-controller="Home" asp-action="Ayuda">Acerca del Proyecto</a>
    </nav>
    <main id="contenido" class="contenido-principal">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
